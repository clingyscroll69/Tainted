# Copy to .env (which is gitignored) and fill in.
#
# Two sections. Everything above the line is the engine and applies wherever Tainted runs;
# everything below it is the website surface only. A variable is listed here even when it has
# a working default, because a default you cannot find is a default you cannot change.


# ===========================================================================================
# Engine — every surface
# ===========================================================================================

# The "meaning" register. Without it static analysis still runs in full: the model only ranks
# request-plane candidates (all of them are tried regardless) and filters tool-plane scopes.
# The report says the register was missing rather than hiding it.
GEMINI_API_KEY=

# Optional model overrides (defaults shown). The `-latest` aliases track the current Gemini
# model so a pinned id can't silently sunset.
TAINTED_LLM_MODEL_JUDGE=gemini-pro-latest
TAINTED_LLM_MODEL_BULK=gemini-flash-latest


# ===========================================================================================
# Website surface
# ===========================================================================================

# --- Is this a developer's own machine? ----------------------------------------------------
# Off by default, so a deployment that never thinks about this gets the safe answer. On, it
# allows two things that are only safe on your own laptop:
#   * naming a repository by filesystem path (on a public deployment: an arbitrary-directory
#     read for anyone who can reach the port);
#   * treating `localhost` as proof you own the target (on a server, that is the server's own
#     loopback, not yours).
# It also enables /docs, /redoc and /openapi.json, and lets sessions use a per-process key.
TAINTED_LOCAL_MODE=

# --- The one secret a hosted deployment must have ------------------------------------------
# Required on anything that is not a developer's own machine. There is no session table: a
# sign-in session is sealed into the cookie itself (AES-256-GCM) and ownership tokens are
# signed, both with keys derived from this one value. Every instance must hold the SAME value
# or a caller who signs in on one is a stranger to the next, and it must stay stable across
# deploys or everyone is signed out and every published ownership token stops verifying.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TAINTED_TOKEN_SECRET=

# --- GitHub sign-in ------------------------------------------------------------------------
# Without these the sign-in button is hidden and the deployment can only run the demo. Register
# an OAuth App at https://github.com/settings/developers with the callback URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The public callback URL. Required on a hosted deployment: behind a TLS-terminating proxy the
# app sees the proxy's scheme and host, not the one the user typed, and a callback that does
# not match the OAuth App's registered URL fails at GitHub with an opaque error. Derived from
# the request in local mode.
#   https://<your-host>/api/auth/github/callback
GITHUB_OAUTH_REDIRECT=

# Default: "repo read:user". `repo` grants read AND write on every private repository the user
# can reach — far more than a scanner needs, and the session cannot be revoked before it
# expires. Drop `repo` for public repositories only.
GITHUB_SCOPES=

# --- Execution sandbox ---------------------------------------------------------------------
# `prove` runs untrusted exploit code in a Docker container, one per run. The host running
# tainted-web needs a working Docker daemon and the pinned sandbox image already pulled;
# there is no setting here that turns this off, and no in-process fallback to fall back to.
TAINTED_REQUIRE_SANDBOX=1

# --- Limits and headers --------------------------------------------------------------------
# Enforce the Content-Security-Policy rather than only reporting it. Unset, the header is
# Content-Security-Policy-Report-Only and nothing is actually blocked.
TAINTED_CSP_ENFORCE=

# How many proves one process will run at once (default 4). Per process, not per deployment.
TAINTED_MAX_CONCURRENT_PROVES=

# How long one prove may hold its request thread, in seconds (default 900).
TAINTED_PROVE_TIMEOUT_S=

# Ceilings on one fetched repository (defaults 250 and 1024). A repository is a stranger's, so
# its size is a stranger's choice. Lower these on a host with a small writable /tmp.
TAINTED_MAX_ARCHIVE_MB=
TAINTED_MAX_EXTRACTED_MB=

# --- Serving -------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Which upstream addresses may set X-Forwarded-* (default 127.0.0.1). Set to your proxy's
# address, or "*" only when nothing but the proxy can reach this port.
FORWARDED_ALLOW_IPS=
# Any non-empty value turns on uvicorn's autoreload. Development only.
TAINTED_RELOAD=
