# Copy to .env (which is gitignored) and fill in.

# Gemini API key — the engine's "meaning" register. Get one from Google AI Studio.
GEMINI_API_KEY=

# Optional model overrides (defaults shown). The `-latest` aliases track the current Gemini
# model so a pinned id can't silently sunset.
TAINTED_LLM_MODEL_JUDGE=gemini-pro-latest
TAINTED_LLM_MODEL_BULK=gemini-flash-latest

# --- website surface only -------------------------------------------------------------
# Signing key for sign-in sessions and ownership tokens. Required on any deployment that is
# not a developer's own machine: the session is sealed into the cookie rather than stored, so
# every instance must hold the same key or a caller who signs in on one is a stranger to the
# next. Keep it stable across deploys. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TAINTED_TOKEN_SECRET=
